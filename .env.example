# Public HTTPS URL routed by Cloudflare Tunnel to http://mcp:8000 (no trailing slash)
BASE_URL=https://mcp.example.com

# Google Cloud OAuth 2.0 Web Application credentials
# Authorized redirect URI in Google Cloud Console: ${BASE_URL}/auth/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret

# Persistent signing & encryption secrets (generate with: openssl rand -base64 32)
JWT_SIGNING_KEY=replace-with-random-secret
STORAGE_ENCRYPTION_KEY=
# Shared secret between mcp and devbox containers (defaults to JWT_SIGNING_KEY if unset)
DEVBOX_INTERNAL_TOKEN=

# Default box name when exec omits the optional 'box' parameter
DEFAULT_BOX=local
# Optional multi-box cluster configuration (JSON string or mounted file path).
# When unset, mcp connects to DEVBOX_URL (default grpc://devbox:50052) as DEFAULT_BOX.
# DEVBOXES_JSON={"default_box":"local","boxes":[{"name":"local","target":"grpc://devbox:50052"},{"name":"gpu-1","target":"grpcs://gpu-1.ts.net:50052","token_env":"DEVBOX_TOKEN_GPU1","pool_size":2}]}
# DEVBOXES_FILE=/etc/mekugi/boxes.json

# Comma-separated Google account emails allowed to call tools (required unless ALLOW_ALL_GOOGLE_USERS=true)
ALLOWED_EMAILS=you@gmail.com

# Cloudflare Zero Trust Tunnel token (route public hostname -> http://mcp:8000)
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflared-tunnel-token

# Optional tuning
MEKUGI_VERSION=v0.7.0
NO_CONFIRMATION_GATE=true
OAUTH_REQUIRE_CONSENT=remember
MAX_CELL_YIELD_TIME_MS=45000
LOG_LEVEL=INFO
