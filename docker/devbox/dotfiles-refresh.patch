index b0db5f4..327dec6 100755
--- a/.local/bin/compile-agent-tools
+++ b/.local/bin/compile-agent-tools
@@ -1,5 +1,5 @@
 #!/bin/sh
-# version: 1.2.0
+# version: 1.2.1
 # Rebuild changed user-owned helper and hook binaries for this machine.
 
 set -eu
@@ -19,7 +19,13 @@ if ! command -v bun >/dev/null 2>&1 || ! command -v scriptc >/dev/null 2>&1; the
 	export PATH
 fi
 scriptc_path=$(command -v scriptc)
-scriptc_identity=$(realpath "$scriptc_path"):$("$scriptc_path" --version)
+scriptc_path=$(realpath "$scriptc_path")
+# Mise shims resolve to mise itself, not to the selected compiler.
+if [ "$(basename "$scriptc_path")" = mise ]; then
+	scriptc_path=$("$scriptc_path" which scriptc)
+	scriptc_path=$(realpath "$scriptc_path")
+fi
+scriptc_identity=$scriptc_path:$("$scriptc_path" --version)
 target_identity=$(uname -s)-$(uname -m)
 mkdir -p "$cache_root"
 state=$cache_root/bootstrap.digest
