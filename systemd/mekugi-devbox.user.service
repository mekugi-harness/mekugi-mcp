[Unit]
Description=Mekugi Devbox Agent (user service)
Documentation=https://github.com/mekugi-harness/mekugi-mcp
After=network-online.target

[Service]
Type=notify
NotifyAccess=main
RuntimeDirectory=mekugi-devbox
RuntimeDirectoryMode=0700
Environment=DEVBOX_WORKDIR=%h
Environment=DEVBOX_GRPC_ADDR=127.0.0.1:50052
Environment=DEVBOX_HOST=127.0.0.1
Environment=DEVBOX_PORT=8080
Environment=SESSION_TMP=%t/mekugi-devbox
Environment=CODE_MODE_HOST_BIN=%h/.local/bin/codex-code-mode-host
Environment=CODE_MODE_DOCS_PATH=%h/.local/share/mekugi/code-mode-docs.json
EnvironmentFile=-%h/.config/mekugi-devbox/env
ExecStart=%h/.local/bin/mekugi-devbox
Restart=on-failure
RestartSec=5s
WatchdogSec=30s
TimeoutStartSec=30s
TimeoutStopSec=15s
KillMode=control-group

[Install]
WantedBy=default.target
