[Unit]
Description=Mekugi Devbox Agent (direct VPS control)
Documentation=https://github.com/mekugi-harness/mekugi-mcp
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
RuntimeDirectory=mekugi-devbox
RuntimeDirectoryMode=0700
Environment=DEVBOX_WORKDIR=/root
Environment=DEVBOX_GRPC_ADDR=127.0.0.1:50052
Environment=DEVBOX_HOST=127.0.0.1
Environment=DEVBOX_PORT=8080
Environment=SESSION_TMP=/run/mekugi-devbox
Environment=CODE_MODE_HOST_BIN=/usr/local/bin/codex-code-mode-host
Environment=CODE_MODE_DOCS_PATH=/usr/local/share/mekugi/code-mode-docs.json
EnvironmentFile=-/etc/mekugi-devbox/env
ExecStart=/usr/local/bin/mekugi-devbox
Restart=on-failure
RestartSec=5s
WatchdogSec=30s
TimeoutStartSec=30s
TimeoutStopSec=15s
KillMode=control-group

[Install]
WantedBy=multi-user.target
