# Shared bearer token (must match the token configured in mekugi-mcp's DEVBOXES_JSON / token_env).
# Generate with: openssl rand -base64 32
DEVBOX_INTERNAL_TOKEN=replace-with-random-secret

# gRPC listen address. Bind to loopback (127.0.0.1:50052) for SSH/Tailscale serve,
# or your private Tailscale/WireGuard IP (e.g. 100.x.y.z:50052). Avoid 0.0.0.0 on public VPSes.
DEVBOX_GRPC_ADDR=127.0.0.1:50052

# Local HTTP health/fallback endpoint (leave DEVBOX_PORT empty to disable HTTP).
DEVBOX_HOST=127.0.0.1
DEVBOX_PORT=8080

# Default working directory and login shell for exec_command.
DEVBOX_WORKDIR=/root
DEVBOX_SHELL=/bin/bash

# Local codex-code-mode-host binary and loopback gRPC target.
CODE_MODE_HOST_BIN=/usr/local/bin/codex-code-mode-host
CODE_MODE_HOST_TARGET=127.0.0.1:50051
CODE_MODE_DOCS_PATH=/usr/local/share/mekugi/code-mode-docs.json

# Optional tuning
MAX_CELL_YIELD_TIME_MS=45000
LOG_LEVEL=info
